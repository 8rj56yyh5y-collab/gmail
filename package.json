{
  "name": "gobsek-mail",
  "version": "1.0.0",
  "description": "Gobsek Mail — рассылка писем компаниям на их языке и сбор ответов во «Входящие»",
  "private": true,
  "main": "server/index.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "demo": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\" && DEMO=1 MAIL_TRANSPORT=json node --no-warnings server/index.js",
    "test": "node --no-warnings --test tests/*.test.js",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\"",
    "share": "node scripts/share.js"
  },
  "dependencies": {
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.5",
    "nodemailer": "^10.6.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.9.0"
  },
  "license": "MIT"
}
