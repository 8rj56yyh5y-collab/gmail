# Скопируйте в .env.local и заполните. Все поля необязательные — почту можно подключить в интерфейсе.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Почтовый ящик (Gmail: адрес + «пароль приложения» из 16 символов)
MAIL_USER=
MAIL_PASSWORD=
# Куда пересылать ответы компаний
FORWARD_TO=
# Перевод ответов на русский и наших ответов на язык компании
ANTHROPIC_API_KEY=
